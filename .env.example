# Firebase Auth public configuration (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Newsroom server-only settings (never prefix these with VITE_)
NEWSROOM_ADMIN_EMAILS=getstarvis@gmail.com
NEWS_PROVIDER=gdelt
NEWSROOM_FIREBASE_SERVICE_ACCOUNT=
# Alternative service-account fields if not using the JSON variable:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional secret for a Vercel Cron trigger. Keep the schedule disabled until
# Firebase Admin credentials and GDELT request cadence have been configured.
CRON_SECRET=
